# Transporte del formulario de contacto:
#   emailjs  -> demo / Netlify (usa las keys de abajo)
#   php      -> producción cPanel (POST a /contact.php)
VITE_CONTACT_TRANSPORT=emailjs

# Credenciales de EmailJS (solo para el transporte "emailjs")
VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
